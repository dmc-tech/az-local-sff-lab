# Copy to terraform.tfvars and set your values (do not commit terraform.tfvars)

resource_group_name = "rg-glove-rock-demo-2-uks"
location            = "UK South"
environment         = "dev"

admin_username = "azureadmin"
# Set a strong password (12+ chars, complexity required by Azure for Windows)
admin_password = "##YourSecurePassword123##"

vm_name           = "vm-azlsff-host1"   # 15 characters max (Windows computer name limit)
nested_vm_prefix  = "NestedVM"
nested_vm_count   = 3   # 1 = single-node SFF lab; 3 = three-node cluster
data_disk_size_gb = 1024 # 1 TB
# Azure Local: OS package (ZIP with provision-os.iso) and Configurator app — override defaults from variables.tf here
os_image_package_url = "https://azurestackreleases.download.prss.microsoft.com/dbazure/AzureLocal/ROE/Composition/10.2610.1.3004/roe-10.2610.1.3004.zip"
configurator_app_url = "https://azurestackreleases.download.prss.microsoft.com/dbazure/AzureLocal/ConfiguratorApp/10.3544.1.3005/V2/ConfiguratorAppV2-10.3544.1.3005.msix"

# Microsoft Entra ID sign-in to the host VM (AADLoginForWindows extension).
# Role granted on the resource group; Administrator Login is needed to run the lab scripts.
vm_login_role = "Virtual Machine Administrator Login"   # or "Virtual Machine User Login"
# Entra object IDs of users/groups to grant it to; leave empty to grant it to whoever runs Terraform.
# Find yours with: az ad signed-in-user show --query id -o tsv
vm_login_principal_ids = []

tags = {
  ManagedBy = "Terraform"
  Project   = "Azure Local SFF Lab"
}
